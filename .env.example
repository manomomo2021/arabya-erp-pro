# =========================================================
# Arabya ERP Pro - Environment Configuration
# =========================================================

# ---------------------------------------------------------
# Application
# ---------------------------------------------------------
NODE_ENV=development

NEXT_PUBLIC_APP_NAME=Arabya ERP Pro
NEXT_PUBLIC_APP_VERSION=2.0.0


# ---------------------------------------------------------
# SQL Server Connection
# ---------------------------------------------------------
MSSQL_SERVER=DESKTOP-NP2I106
MSSQL_PORT=1433
MSSQL_DATABASE=ArabyaDB

MSSQL_USER=sa
MSSQL_PASSWORD=11111

MSSQL_ENCRYPT=false
MSSQL_TRUST_SERVER_CERTIFICATE=true

MSSQL_CONNECTION_TIMEOUT=15000
MSSQL_REQUEST_TIMEOUT=30000


# ---------------------------------------------------------
# Session
# ---------------------------------------------------------
SESSION_SECRET=1z8JexHWK8y1JzsUNxRas5PhCD/0VtN1jYCCtvJ+7mgi9UgJoSuXkvH955c1P2/z


# =========================================================
# ERP HUB Authentication
# =========================================================

# Authentication database
ERP_AUTH_DATABASE=ArabyaSC
ERP_AUTH_SCHEMA=dbo
ERP_AUTH_TABLE=Users

# User fields
ERP_AUTH_USER_COLUMN=UserId
ERP_AUTH_PASSWORD_COLUMN=UserPass
ERP_AUTH_ACTIVE_COLUMN=Active

# User profile
ERP_AUTH_ARABIC_NAME_COLUMN=UserArabicName
ERP_AUTH_LATIN_NAME_COLUMN=UserLatinName

# Permissions flags
ERP_AUTH_ADMIN_COLUMN=Admin
ERP_AUTH_IT_COLUMN=IsIT


# =========================================================
# ERP HUB Branch Permissions
# =========================================================

ERP_BRANCH_PERMISSION_DATABASE=ArabyaSC
ERP_BRANCH_PERMISSION_SCHEMA=dbo
ERP_BRANCH_PERMISSION_TABLE=BranchesPer

ERP_BRANCH_PERMISSION_USER_COLUMN=UserID
ERP_BRANCH_PERMISSION_BRANCH_COLUMN=BranchID

# ERP system identifier
ERP_BRANCH_PERMISSION_SYS_ID=207


# =========================================================
# Branch Master
# =========================================================

ERP_BRANCH_DATABASE=ArabyaDB
ERP_BRANCH_SCHEMA=dbo
ERP_BRANCH_TABLE=Branches

ERP_BRANCH_CODE_COLUMN=BranchCode
ERP_BRANCH_ARABIC_NAME_COLUMN=BranchAraName
ERP_BRANCH_ENGLISH_NAME_COLUMN=BranchEngName
ERP_BRANCH_INACTIVE_COLUMN=NotActive


# =========================================================
# Financial Period
# =========================================================

ERP_PERIOD_DATABASE=ArabyaDB
ERP_PERIOD_SCHEMA=dbo
ERP_PERIOD_TABLE=Period

ERP_PERIOD_YEAR_COLUMN=Year


# =========================================================
# Authentication Mode
# =========================================================

APP_AUTH_MODE=erp-hub
ERP_AUTH_PASSWORD_MODE=md5
